<%# locals: (name:, label:, hint:, dark: false, square: false) %>
<% types, _max = Custom::WhiteLabel::IMAGES[name] %>
<% current = @account.white_label_image_path(name) %>
<% error = @account.errors[name].first %>
<% scope = 'flow_white_label.super_admin.logos' %>
<div class="flex gap-4 p-3 rounded-lg outline outline-1 -outline-offset-1 <%= error ? 'outline-n-ruby-9' : 'outline-n-container' %>" data-image-field="<%= name %>">
  <div class="flex items-center justify-center flex-shrink-0 overflow-hidden rounded-md <%= square ? 'size-16' : 'w-28 h-16' %> <%= dark ? 'bg-slate-900' : 'bg-n-alpha-1' %>">
    <img data-image-preview src="<%= current %>" alt="" class="max-w-full max-h-full object-contain p-2 <%= 'hidden' unless current %>">
    <span data-image-empty class="text-[11px] text-center px-1 <%= dark ? 'text-slate-400' : 'text-n-slate-10' %> <%= 'hidden' if current %>"><%= t("#{scope}.empty") %></span>
  </div>
  <div class="flex flex-col flex-1 min-w-0 gap-1">
    <span class="text-sm font-medium text-n-slate-12"><%= label %></span>
    <% if error %>
      <p class="flex items-center gap-1.5 m-0 text-xs text-n-ruby-11">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>
        <%= error %>
      </p>
    <% else %>
      <p class="m-0 text-xs text-n-slate-11"><%= hint %></p>
    <% end %>
    <div class="flex flex-wrap items-center gap-2 mt-1">
      <label class="inline-flex items-center h-8 gap-1.5 px-3 text-xs font-medium rounded-lg cursor-pointer bg-n-alpha-2 text-n-slate-12 hover:bg-n-alpha-1 focus-within:outline focus-within:outline-2 focus-within:outline-n-brand">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M17 8l-5-5-5 5M12 3v12"/></svg>
        <span><%= current ? t("#{scope}.replace") : t("#{scope}.choose") %></span>
        <input type="file" name="white_label[<%= name %>]" accept="<%= types.join(',') %>" class="sr-only" data-image-input>
      </label>
      <% if current %>
        <label class="inline-flex items-center h-8 gap-1.5 px-2 text-xs font-medium rounded-lg cursor-pointer text-n-ruby-11 hover:bg-n-alpha-1">
          <input type="checkbox" name="white_label[remove][]" value="<%= name %>" class="size-3.5 rounded border-n-weak accent-n-ruby-9" data-image-remove>
          <%= t("#{scope}.remove") %>
        </label>
      <% end %>
    </div>
  </div>
</div>

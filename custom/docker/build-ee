#!/usr/bin/env bash
# Builds the fork's EE image (enterprise/ + custom/) from a clean, shallow clone of a branch,
# so local edits and untracked files never end up in it.
#
#   custom/docker/build-ee [branch]     default: the current branch
#   FLOW_VERSION=0.1.0 custom/docker/build-ee flow-chat-v0.1.0   also bakes the fork release and tags flow-chat-v0.1.0
#
# Tags flow-chatwoot:<version>-<sha>-ee, <sha>-ee and latest-ee (<version> is Chatwoot's, from
# config/app.yml; <sha> is 9 characters) and stamps the OCI labels publish-ghcr reads. Test it
# with custom/docker/ee-local, publish it with custom/docker/publish-ghcr.
set -euo pipefail

repo="$(cd "$(dirname "$0")/../.." && pwd)"
branch="${1:-$(git -C "$repo" rev-parse --abbrev-ref HEAD)}"
build="$(mktemp -d /tmp/flow-chatwoot-build.XXXXXX)"
trap 'rm -rf "$build"' EXIT

# Shallow: the checkout is a blob:none partial clone, and a full clone would need history
# objects it never downloaded. The Dockerfile reads `git rev-parse HEAD`, so .git stays.
git clone -q --depth 1 --branch "$branch" "file://$repo" "$build"
cd "$build"
sha="$(git rev-parse --short=9 HEAD)"
version="$(grep -m1 -E '^\s*version:' config/app.yml | grep -oE '[0-9]+(\.[0-9]+)+')"
test -n "$version"

# The edition marker fazer.ai's latest-ee workflow adds; enterprise/ is kept (no rm -rf).
printf '\nENV CW_EDITION="ee"\n' >> docker/Dockerfile
test -d enterprise && test -d custom

# The fork's own release (git tag flow-chat-vX.Y.Z), when the build is one: baked in as FLOW_VERSION, read by /flow/version.
flow_version="${FLOW_VERSION:-}"
if [ -n "$flow_version" ]; then
  printf '\nENV FLOW_VERSION="%s"\n' "$flow_version" >> docker/Dockerfile
fi

# Hardening applied to the checkout instead of editing fazer.ai's files, so a sync from
# upstream never conflicts. Each step fails the build when its target is gone, rather than
# silently shipping the unhardened image.

# Base images by digest (custom/docker/base-images.pins): a rebuild starts from the same bytes.
while IFS='=' read -r ref digest; do
  case "$ref" in '' | '#'*) continue ;; esac
  grep -q -E "^FROM ${ref}( |\$)" docker/Dockerfile || { echo "base-images.pins: no 'FROM ${ref}' in docker/Dockerfile" >&2; exit 1; }
  sed -i -E "s#^FROM ${ref}( |\$)#FROM ${ref}@${digest}\1#" docker/Dockerfile
done < "$repo/custom/docker/base-images.pins"

# No compiler toolchain in the runtime stage: the gems are compiled in the pre-builder.
final="$(grep -n '^FROM ' docker/Dockerfile | tail -1 | cut -d: -f1)"
before="$(grep -c '^  build-base \\$' docker/Dockerfile)"
awk -v f="$final" 'NR > f && /^  build-base \\$/ { next } { print }' docker/Dockerfile > docker/Dockerfile.hardened
mv docker/Dockerfile.hardened docker/Dockerfile
test "$(grep -c '^  build-base \\$' docker/Dockerfile)" -eq $((before - 1))

# Development tooling and agent configuration never enter the image (COPY . /app honors this).
printf '%s\n' '' '# Flow: development tooling and agent configuration, not needed at runtime.' \
  .github .circleci .devcontainer .husky .vscode .qlty .dependabot .claude .impeccable .windsurf \
  .codex-review-waived e2e tests AGENTS.md CLAUDE.md >> .dockerignore

# No org.opencontainers.image.source: it links the package to the (public) repository.
echo "Building flow-chatwoot:${version}-${sha}-ee from ${branch}"
docker build -f docker/Dockerfile \
  --label org.opencontainers.image.title="Flow Agents Chatwoot (EE)" \
  --label org.opencontainers.image.version="${version}-${sha}-ee" \
  --label org.opencontainers.image.revision="$(git rev-parse HEAD)" \
  --label org.opencontainers.image.created="$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
  --label org.opencontainers.image.ref.name="$branch" \
  ${flow_version:+--label io.flow.chat.version="$flow_version" -t "flow-chatwoot:flow-chat-v$flow_version"} \
  -t "flow-chatwoot:${version}-${sha}-ee" -t "flow-chatwoot:${sha}-ee" -t flow-chatwoot:latest-ee .
docker images flow-chatwoot --format '{{.Repository}}:{{.Tag}} {{.Size}} {{.CreatedSince}}'

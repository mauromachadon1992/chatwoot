#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

# lint js and vue files
npx --no-install lint-staged

# lint only staged ruby files (-r: with none staged, xargs would run rubocop on the whole repo)
git diff --name-only --cached | xargs -r ls -1 2>/dev/null | grep '\.rb$' | xargs -r bundle exec rubocop --force-exclusion

